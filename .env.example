# Sao chép thành .env rồi điền giá trị thật. KHÔNG đưa .env lên git.
# Mọi giá trị dưới đây là chỗ giữ chỗ. Cột "Dùng ở" xem SPEC.md mục 15.
# Giá trị CHANGE_ME hoặc có chữ SUFFIX được api coi là "chưa cấu hình": Azure Search, Maps,
# Application Insights tự tắt, không báo lỗi. Với nhóm, SUFFIX là pt2026 (ví dụ stphongtropt2026).
# Khóa và chuỗi kết nối Azure lấy từ .env.azure (do infra/azure/setup.sh tạo) hoặc từ Key Vault.

TZ=Asia/Ho_Chi_Minh
DATA_DIR=./data                     # trên vm-data: /srv/data (volume Cinder)

# --- PostgreSQL ---
DB_HOST=db                          # trên vm-app: IP nội bộ của vm-data
DB_PORT=5432
DB_NAME=phongtro_db
DB_USER=phongtro_user
DB_PASSWORD=CHANGE_ME

# --- MinIO ---
MINIO_ENDPOINT=minio:9000           # trên vm-app: <IP nội bộ vm-data>:9000
MINIO_SECURE=false                  # true nếu MinIO chạy HTTPS
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_PRIVATE=private
MINIO_BUCKET_PUBLIC_SRC=public-src
MC_ALIAS=local                      # alias MinIO Client cho backup.sh (tùy chọn)

# --- Backend (api) ---
JWT_SECRET=CHANGE_ME                # tạo bằng: openssl rand -hex 32
JWT_EXPIRE_MINUTES=720
SEED_DEMO_PASSWORD=CHANGE_ME        # mật khẩu chung cho tài khoản demo trong seed
EST_KWH_PER_MONTH=100               # ước tính mặc định cho chi phí thực tế
EST_WATER_M3_PER_MONTH=4
EST_PEOPLE=1
EST_VEHICLES=1
SEARCH_TIMEOUT_MS=3000              # quá thời gian này thì tìm kiếm dự phòng bằng DB
CORS_ORIGINS=                       # để trống: web và api cùng nguồn qua nginx; khi dev tách cổng ghi vd http://localhost:5173
REVIEW_SKIP_BOOKING_CHECK=false     # true: cho đánh giá không cần lịch xem "done" (chỉ để demo, SPEC 9.4)
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16   # mạng tin cậy gửi X-Forwarded-For (nginx)

# --- Worker ---
OUTBOX_POLL_SECONDS=5
QUEUE_POLL_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10

# --- Azure ---
# Function (Người 5 deploy). Khóa hàm nằm ở Key Vault (function-key); chưa có thì worker tạm dừng gửi, không báo lỗi.
AZURE_FUNCTION_INGEST_URL=https://func-phongtro-SUFFIX.azurewebsites.net/api/ingest-room
AZURE_FUNCTION_KEY=CHANGE_ME
# AI Search: api chỉ dùng khóa CHỈ ĐỌC. Khóa admin chỉ nằm ở Function (Key Vault: search-admin-key), không đưa vào file này.
AZURE_SEARCH_ENDPOINT=https://srch-phongtro-SUFFIX.search.windows.net
AZURE_SEARCH_INDEX=rooms-public
AZURE_SEARCH_QUERY_KEY=CHANGE_ME
# Maps: khóa riêng, lộ ra trình duyệt qua /api/v1/config (Key Vault: azure-maps-key)
AZURE_MAPS_KEY=CHANGE_ME
# Storage: ảnh công khai và hàng đợi
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME
AZURE_QUEUE_NAME=ops-ticks
AZURE_BLOB_PUBLIC_BASE_URL=https://stphongtroSUFFIX.blob.core.windows.net/public-images
# Sao lưu
AZURE_BACKUP_CONTAINER_URL=https://stphongtroSUFFIX.blob.core.windows.net/backups
AZURE_BACKUP_SAS_WRITE=CHANGE_ME    # SAS quyền create+write (cho backup.sh)
AZURE_BACKUP_SAS_READ=CHANGE_ME     # SAS quyền read+list (cho restore-test.sh)
AZURE_KEY_VAULT_URL=https://kv-phongtro-SUFFIX.vault.azure.net
APPLICATIONINSIGHTS_CONNECTION_STRING=CHANGE_ME

# --- Sao lưu ---
BACKUP_PASSPHRASE=CHANGE_ME         # bản gốc ở Key Vault: backup-passphrase
BACKUP_DIR=/var/backups/phongtro
KEEP_LOCAL=3

# --- Thông báo (gửi từ worker trên OpenStack) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_NAME=easyrent2006_bot  # tên đăng nhập của bot, không có @ (không phải bí mật)
